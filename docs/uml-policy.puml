@startuml
!pragma layout smetana
skinparam dpi 160
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #263747
skinparam ArrowColor #263747
hide empty members
interface EUK00361749_PricingPolicy {
 + abstract Invoice calculate(List<OrderLine>)
}

class EUK00361749_CategoryPricing {
 + CategoryPricing()
 - {static} BigDecimal money(BigDecimal)
 + Invoice calculate(List<OrderLine>)
}

enum EUK00361749_OrderStatus {
 + {static} OrderStatus PLACED
 + {static} OrderStatus PREPARING
 + {static} OrderStatus OUT_FOR_DELIVERY
 + {static} OrderStatus DELIVERED
 + {static} OrderStatus CANCELLED
 - OrderStatus()
 + boolean cancellable()
 + OrderStatus next()
}

enum EUK00361749_TimeSlot {
 + {static} TimeSlot MORNING_09_12
 + {static} TimeSlot AFTERNOON_12_16
 + {static} TimeSlot EVENING_16_20
 - TimeSlot()
}

class EUK00361749_Validation {
 - Validation()
 + {static} String text(String, String, int)
 + {static} String email(String)
 + {static} String nic(String)
 + {static} String phone(String)
 + {static} String productId(String)
}

EUK00361749_CategoryPricing ..|> EUK00361749_PricingPolicy
EUK00361749_OrderStatus -[hidden]down- EUK00361749_TimeSlot
EUK00361749_TimeSlot -[hidden]down- EUK00361749_Validation
@enduml
