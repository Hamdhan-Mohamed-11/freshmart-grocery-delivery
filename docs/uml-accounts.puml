@startuml
!pragma layout smetana
skinparam dpi 160
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #263747
skinparam ArrowColor #263747
hide empty members
abstract class EUK00361749_Account {
 - String id
 - String name
 - String email
 - String passwordHash
 # Account(String, String, String, String)
 + String id()
 + String name()
 + String email()
 ~ String passwordHash()
 + boolean authenticates(char[])
 + abstract String role()
}

class EUK00361749_Admin {
 + Admin(String, String, String)
 + String role()
}

class EUK00361749_Customer {
 - String phone
 - String address
 + Customer(String, String, String, String, String, String)
 + String phone()
 + String address()
 + String role()
 + String toString()
}

class EUK00361749_Password {
 - {static} int ITERATIONS
 - Password()
 + {static} String hash(char[])
 + {static} boolean verify(char[], String)
 - {static} byte[] derive(char[], byte[], int)
}

EUK00361749_Admin --|> EUK00361749_Account
EUK00361749_Customer --|> EUK00361749_Account
EUK00361749_Account ..> EUK00361749_Password
@enduml
