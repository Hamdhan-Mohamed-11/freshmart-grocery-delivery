}

class EUK00361749_Invoice <<record>> {
  - lines : List<EUK00361749_OrderLine>
  - productTotal : BigDecimal
  - discount : BigDecimal
  - deliveryFee : BigDecimal
  - tax : BigDecimal
  - finalPayable : BigDecimal
