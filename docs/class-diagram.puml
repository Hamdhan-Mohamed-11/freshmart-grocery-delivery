  + {static} formatMoney(amount : BigDecimal) : String
}

interface EUK00361749_PricingPolicy <<Strategy>> {
  + calculate(lines : List<OrderLine>) : EUK00361749_Invoice
}

class EUK00361749_CategoryPricing {
  + {static} DISCOUNT_THRESHOLD : BigDecimal
