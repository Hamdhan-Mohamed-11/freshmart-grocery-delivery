}

enum EUK00361749_Category {
  VEGETABLES
  FRUITS
  DAIRY
  HOUSEHOLD_ESSENTIALS
  - displayName : String
  - deliveryFee : BigDecimal
  - minimumOrderValue : BigDecimal
  - discountRate : BigDecimal
  - taxRate : BigDecimal
  + getDeliveryFee() : BigDecimal
  + getMinimumOrderValue() : BigDecimal
  + getDiscountRate() : BigDecimal
  + getTaxRate() : BigDecimal
}

enum EUK00361749_StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum EUK00361749_TimeSlot {
  MORNING_09_12
  AFTERNOON_12_16
  EVENING_16_20
}

enum EUK00361749_OrderStatus {
  PLACED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
