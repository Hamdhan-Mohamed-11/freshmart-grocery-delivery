  + {abstract} getMenuTitle() : String
}

class EUK00361749_Admin {
  + {static} ADMIN_ACCOUNT_ID : String
  + EUK00361749_Admin(name : String, email : String, passwordHash : String)
  + getRole() : String
  + getMenuTitle() : String
}

class EUK00361749_Customer {
