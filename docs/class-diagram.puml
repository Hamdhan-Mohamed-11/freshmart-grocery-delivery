  + {static} statusForQuantity(quantity : int) : EUK00361749_StockStatus
  + withStockQuantity(newQuantity : int) : EUK00361749_Product
  + withStockStatus(newStatus : StockStatus) : EUK00361749_Product
}

class EUK00361749_OrderLine <<record>> {
  - productId : String
  - name : String
  - category : EUK00361749_Category
  - unitPrice : BigDecimal
  - quantity : int
  + {static} fromProduct(product : Product, quantity : int) : EUK00361749_OrderLine
  + lineTotal() : BigDecimal
}

class EUK00361749_Order <<record>> {
  - orderId : String
  - customerId : String
  - customerDetails : String
  - deliveryDate : LocalDate
  - timeSlot : EUK00361749_TimeSlot
  - status : EUK00361749_OrderStatus
